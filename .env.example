# Copy this file to .env.local and fill it in:  cp .env.example .env.local
#
# The first block is all a self-hosted install needs. Everything after it is
# optional and commented out: leave a line commented until you need it, since
# an empty value isn't the same as unset for some of them.
# Notes: README.md, "Environment".

# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# Public URL of this app. It's baked into /embed.js at build time, so set it
# before `npm run build` when you deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Supabase. Locally, run `supabase start`, then copy the API URL, the anon key
# and the service_role key from `supabase status`. In production, use your
# project's values (Project settings > API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Google Gemini, for search, summaries, transcribing calls, and replies from
# Gemini models (https://aistudio.google.com/apikey). Calls need a project on
# Tier 2 or higher to run many at once (about 1,000; Tier 1 allows 50).
GOOGLE_API_KEY=

# Two secrets of 32+ random characters each, e.g. from `openssl rand -hex 32`.
# Keep ENCRYPTION_KEY once it's set: it encrypts stored API keys and headers,
# and changing it makes them unreadable.
WIDGET_SESSION_SECRET=
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Calls
# ----------------------------------------------------------------------------

# ElevenLabs, for the assistant's voice on calls (Text to Speech access) and
# backup speech-to-text (Speech to Text access); calls are transcribed by
# Gemini first, with GOOGLE_API_KEY. Without it, assistants are text-only.
# ELEVENLABS_API_KEY=

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Claude and GPT models, for an assistant's model or its fallback (picked on its
# Behavior page). The default model is Claude Haiku 5.5: without
# ANTHROPIC_API_KEY, assistants answer with Gemini 3.8 Flash instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Email for follow-up requests and workspace invitations through Resend, and in
# the hosted edition the welcome and subscription emails. Sign-in codes are sent
# by Supabase Auth instead (set up SMTP in your Supabase project).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Assistant <notifications@yourdomain.com>"

# Rate limits shared across server instances. Without these they're kept in
# each instance's memory, which is fine for a single server.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# "Connect with Stripe" for your assistants installs your Stripe App
# (integrations/stripe-app; README, "Integrations"). The install URLs are the
# OAuth links on the app's page in Stripe. Live installs exchange codes with
# STRIPE_APP_SECRET_KEY, or STRIPE_SECRET_KEY when it's unset; sandbox installs
# with the app's managed sandbox key. Without them, people paste a restricted key.
# STRIPE_SECRET_KEY=
# STRIPE_APP_INSTALL_URL=
# STRIPE_APP_SECRET_KEY=
# STRIPE_APP_SANDBOX_INSTALL_URL=
# STRIPE_APP_SANDBOX_SECRET_KEY=

# Integrations that connect with OAuth. Each is optional: without its pair,
# that service's card on the Integrations page explains what's missing, and
# HubSpot, Calendly, Cal.com and Salesforce still connect with a key or the
# customer's own app. Zendesk needs nothing here. Register
# <NEXT_PUBLIC_APP_URL>/api/integrations/<service>/callback as the redirect
# URL. Setup for each: README.md, "Integrations".
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# CALCOM_CLIENT_ID=
# CALCOM_CLIENT_SECRET=
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=

# Protects the knowledge worker's daily refresh call
# (GET /api/knowledge/worker with "Authorization: Bearer <CRON_SECRET>").
# Without it, a key derived from WIDGET_SESSION_SECRET is used.
# CRON_SECRET=

# How often website pages are re-read automatically, in days (default 7, 0 turns it off).
# KNOWLEDGE_AUTO_REFRESH_DAYS=7

# Reading pages that only show content in a browser:
#   local  (default) an installed Chrome or Chromium, or CHROMIUM_PATH
#   remote a hosted browser at BROWSER_WS_ENDPOINT, e.g. Browserless
#   off    only read plain HTML
# KNOWLEDGE_BROWSER=local
# CHROMIUM_PATH=
# BROWSER_WS_ENDPOINT=

# The dashboard's help assistant. `npm run app-assistant` creates it and prints both.
# NEXT_PUBLIC_APP_ASSISTANT_ID=
# APP_ASSISTANT_WORKSPACE_ID=

# Comma-separated emails that can open /admin/costs.
# PLATFORM_ADMIN_EMAILS=you@yourdomain.com

# Development only: lets actions and imports reach localhost and private addresses.
# ALLOW_PRIVATE_URLS=true

# Google sign-in, for local Supabase only (supabase/config.toml). These two go
# in .env, not .env.local: the Supabase CLI reads them, the app doesn't. In
# production, set up the Google provider in the Supabase dashboard instead.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ----------------------------------------------------------------------------
# Hosted edition only
# ----------------------------------------------------------------------------
# Leave these unset when you run it yourself. "cloud" turns on plans, billing
# and the marketing site; unset, the app has every feature and no limits.
# Billing also needs STRIPE_SECRET_KEY, above.
# Locally, ./start-webhooks.sh sets STRIPE_BILLING_WEBHOOK_SECRET for you.

# NEXT_PUBLIC_EDITION=cloud
# STRIPE_BILLING_WEBHOOK_SECRET=
# NEXT_PUBLIC_DEMO_AGENT_ID=

# Google Analytics for the marketing site, e.g. G-XXXXXXXXXX. It only loads
# after a visitor allows it in the cookie banner; unset, there's no banner.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
